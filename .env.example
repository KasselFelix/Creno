# Copier en .env : `cp .env.example .env`. Ces valeurs factices suffisent pour le développement local.
NODE_ENV=development

# Base de données (dans docker compose, l'hôte est `db` ; en local hors docker, `localhost`)
DB_PORT=5432
DATABASE_URL=postgres://creno:creno@localhost:5432/creno
DATABASE_URL_TEST=postgres://creno:creno@localhost:5432/creno_test

# API
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
# Nombre de proxys DE CONFIANCE devant l'API (ils doivent réécrire X-Forwarded-For). Le rewrite de
# Next ne l'ajoute pas : laisser false en local, sinon un client choisit son IP et contourne le rate limit.
TRUST_PROXY=false

# Auth — secret de signature des access tokens (HS256, 32 caractères minimum).
# Valeur d'exemple : acceptée en dev, REFUSÉE en production. Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Tentatives de login/inscription par minute et par IP (x3 pour le refresh).
AUTH_RATE_LIMIT_PER_MINUTE=10
# Demandes d'inscription par heure et par IP (chacune envoie un email). Par IP réelle seulement si TRUST_PROXY est juste.
REGISTRATION_RATE_LIMIT_PER_HOUR=20
# Lectures publiques (fiche prestataire, ressource, créneaux, recherche, géocodage), par minute, par IP et par route ;
# demandes de réservation, par minute et par IP.
PUBLIC_RATE_LIMIT_PER_MINUTE=120
BOOKING_RATE_LIMIT_PER_MINUTE=20
# Demandes de code de vérification du téléphone, par heure et par IP (chacune envoie un SMS).
PHONE_CODE_RATE_LIMIT_PER_HOUR=10

# Géocodage des adresses : API Adresse de l'État (Géoplateforme IGN), sans clé. France uniquement.
GEOCODER_URL=https://data.geopf.fr/geocodage

# Paiements : Stripe Connect, en MODE TEST uniquement en dev (une clé sk_live_ est refusée hors production).
# Laisser vide : l'API démarre quand même, et les routes de paiement répondent 503.
# Clé secrète de test : https://dashboard.stripe.com/test/apikeys (activer Connect dans le compte).
STRIPE_SECRET_KEY=
# Secret de signature du webhook. En local, il est affiché par `docker compose --profile stripe up`
# (service stripe-cli) ou par `stripe listen --forward-to localhost:4000/v1/payments/webhook`.
STRIPE_WEBHOOK_SECRET=
# Production seulement : secret de l'endpoint « Connect » (événement account.updated), distinct du précédent.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Commission Creno en points de base : 1000 = 10 % du prix (0 à 5000).
STRIPE_PLATFORM_FEE_BPS=1000
# Seed : compte Stripe Express de test (acct_…) rattaché à « Studio Lumière », pour ne pas refaire
# l'onboarding après chaque `pnpm db:seed`. Vide : aucun prestataire de démo n'encaisse.
SEED_STRIPE_ACCOUNT_ID=

# Notifications. Sans aucune de ces variables, l'API démarre et les notifications sont marquées
# `skipped` : rien n'est envoyé.
# Emails : clé API Resend (re_…, https://resend.com/api-keys). Obligatoire en production, avec un
# EMAIL_FROM sur un domaine vérifié.
RESEND_API_KEY=
# Expéditeur. Avec Resend, le domaine doit être vérifié (onboarding@resend.dev n'écrit qu'à l'adresse du compte).
EMAIL_FROM=Creno <onboarding@resend.dev>
# Boîte de réception de dev, utilisée quand RESEND_API_KEY est vide. docker compose la renseigne
# tout seul (service mailpit, http://localhost:8025) ; hors docker : http://localhost:8025. Interdite en production.
MAILPIT_URL=
# SMS (codes de vérification du téléphone, rappels) : compte Twilio (les trois variables ensemble,
# ou aucune). TWILIO_FROM est un numéro au format international (+33…) ou un Messaging Service (MG…).
# Sans Twilio mais avec MAILPIT_URL, les SMS arrivent dans Mailpit (adressés à <numéro>@sms.mailpit.local).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Préfixes des numéros qui peuvent recevoir un SMS (défaut : mobiles français). Hors liste : aucun envoi.
SMS_ALLOWED_PREFIXES=+336,+337
# Jobs (pg-boss) : `false` pour une instance qui crée des jobs sans les exécuter.
JOBS_WORKERS_ENABLED=true

# Web : URL de l'API utilisée côté serveur par Next (rewrite /api/* et Server Components)
API_INTERNAL_URL=http://localhost:4000

# Carte de la recherche : token PUBLIC Mapbox (pk.…), à créer sur https://account.mapbox.com et à
# restreindre par URL. Il est envoyé au navigateur : ne jamais mettre de token secret (sk.…) ici.
# Vide : la recherche fonctionne en liste seule, avec un encart « Carte indisponible ».
NEXT_PUBLIC_MAPBOX_TOKEN=
