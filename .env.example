# Copier en .env : `cp .env.example .env`. Ces valeurs factices suffisent pour le développement local.
NODE_ENV=development

# Base de données (dans docker compose, l'hôte est `db` ; en local hors docker, `localhost`)
DB_PORT=5432
DATABASE_URL=postgres://creno:creno@localhost:5432/creno
DATABASE_URL_TEST=postgres://creno:creno@localhost:5432/creno_test

# API
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
# Nombre de proxys DE CONFIANCE devant l'API (ils doivent réécrire X-Forwarded-For). Le rewrite de
# Next ne l'ajoute pas : laisser false en local, sinon un client choisit son IP et contourne le rate limit.
TRUST_PROXY=false

# Auth — secret de signature des access tokens (HS256, 32 caractères minimum).
# Valeur d'exemple : acceptée en dev, REFUSÉE en production. Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Tentatives de login/inscription par minute et par IP (x3 pour le refresh).
AUTH_RATE_LIMIT_PER_MINUTE=10

# Web : URL de l'API utilisée côté serveur par Next (rewrite /api/* et Server Components)
API_INTERNAL_URL=http://localhost:4000
