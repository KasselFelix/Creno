# Copier en .env : `cp .env.example .env`. Ces valeurs factices suffisent pour le développement local.
NODE_ENV=development

# Base de données (dans docker compose, l'hôte est `db` ; en local hors docker, `localhost`)
DB_PORT=5432
DATABASE_URL=postgres://creno:creno@localhost:5432/creno
DATABASE_URL_TEST=postgres://creno:creno@localhost:5432/creno_test

# API
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Web : URL de l'API utilisée côté serveur par Next (rewrite /api/* et Server Components)
API_INTERNAL_URL=http://localhost:4000
