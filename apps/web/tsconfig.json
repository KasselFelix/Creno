{
  "extends": "@creno/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
